# ============================================================================
# БАЗА ДАННЫХ (PostgreSQL + pgvector)
# ============================================================================
# Создаётся автоматически при первом запуске Docker
POSTGRES_USER=tender_admin
POSTGRES_PASSWORD=СЛОЖНЫЙ_ПАРОЛЬ_МИНИМУМ_32_СИМВОЛА
POSTGRES_DB=tender_saas

# Формат: postgresql+asyncpg://user:password@host:port/database
# host=postgres — имя сервиса в docker-compose.yml
DATABASE_URL=postgresql+asyncpg://tender_admin:СЛОЖНЫЙ_ПАРОЛЬ_МИНИМУМ_32_СИМВОЛА@postgres:5432/tender_saas

# ============================================================================
# REDIS (кеширование, Celery broker)
# ============================================================================
# host=redis — имя сервиса в docker-compose.yml
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ============================================================================
# JWT (JSON Web Tokens для авторизации)
# ============================================================================
# Генерируется командой: openssl rand -hex 32
SECRET_KEY=ваш_секретный_ключ_64_символа_генерируется_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# YOOKASSA (платёжная система)
# ============================================================================
# Берётся из личного кабинета YooKassa: https://yookassa.ru
# Shop ID — идентификатор магазина
YOOKASSA_SHOP_ID=ваш_shop_id_из_личного_кабинета_yookassa
# Secret Key — секретный ключ для API (генерируется в настройках магазина)
YOOKASSA_SECRET_KEY=ваш_secret_key_из_личного_кабинета_yookassa
# URL для webhook (YooKassa отправляет сюда уведомления об оплате)
# В проде: https://bidflow.ru/api/v1/payments/webhook
YOOKASSA_WEBHOOK_URL=https://bidflow.ru/api/v1/payments/webhook

# ============================================================================
# YANDEX GPT (основная LLM)
# ============================================================================
# Берётся из Yandex Cloud Console: https://console.cloud.yandex.ru
# 1. Создайте сервисный аккаунт с ролью "ai.languageModels.user"
# 2. Создайте API-ключ для сервисного аккаунта
YANDEX_GPT_API_KEY=ваш_api_key_из_yandex_cloud_console
# Folder ID — ID каталога в Yandex Cloud (где активирована YandexGPT)
YANDEX_GPT_FOLDER_ID=ваш_folder_id_из_yandex_cloud

# ============================================================================
# GIGACHAT (fallback LLM)
# ============================================================================
# Берётся из GigaChat API: https://developers.sber.ru/studio/workspaces
# 1. Создайте проект в GigaChat API
# 2. Получите Client ID и Client Secret
GIGACHAT_CLIENT_ID=ваш_client_id_из_gigachat_api
GIGACHAT_CLIENT_SECRET=ваш_client_secret_из_gigachat_api

# Какой провайдер использовать по умолчанию: yandex_gpt или gigachat
DEFAULT_LLM_PROVIDER=yandex_gpt

# ============================================================================
# EMAIL (Postmark для отправки писем)
# ============================================================================
# Регистрируется на https://postmarkapp.com
# Server API Token — токен для отправки писем через API
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=ваш_postmark_server_api_token
SMTP_PASSWORD=ваш_postmark_server_api_token
# Для прода: noreply@bidflow.ru (домен должен быть подтверждён в Postmark)
EMAIL_FROM=noreply@bidflow.ru

# ============================================================================
# MAX MESSENGER (опциональные уведомления)
# ============================================================================
# Создаётся бот через @MasterBot в MAX
# Token бота — токен для отправки сообщений
MAX_BOT_TOKEN=ваш_max_bot_token
MAX_WEBHOOK_URL=https://bidflow.ru/api/v1/notifications/max/webhook

# ============================================================================
# ПРИЛОЖЕНИЕ
# ============================================================================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# В проде: https://bidflow.ru (для локальной разработки — http://localhost:3000)
FRONTEND_URL=https://bidflow.ru
DEMO_DAYS=3

# ============================================================================
# МОНИТОРИНГ (Grafana)
# ============================================================================
GRAFANA_ADMIN_PASSWORD=ваш_пароль_для_grafana

# ============================================================================
# КРИПТОПРО (ЭЦП)
# ============================================================================
# Путь к КриптоПро на сервере (если используется локальная подпись)
CRYPTO_PRO_PATH=/opt/cprocsp