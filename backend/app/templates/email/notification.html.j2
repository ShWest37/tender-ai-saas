<!DOCTYPE html>
<html lang="ru">
<head><meta charset="utf-8"><title>{{ title }}</title></head>
<body style="font-family: Arial, sans-serif; color:#111827; max-width:600px; margin:0 auto; padding:24px;">
  <h2 style="color:#2563eb;">{{ title }}</h2>
  <p style="font-size:16px; line-height:1.6;">{{ body }}</p>
  {% if action_url %}
    <p style="margin-top:24px;">
      <a href="{{ action_url }}" style="background:#2563eb;color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none;">
        {{ action_label or 'Открыть' }}
      </a>
    </p>
  {% endif %}
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:32px 0;">
  <p style="color:#9ca3af;font-size:12px;">Tender AI Director — автоматизация тендеров</p>
</body>
</html>
